<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Galería de recetas" android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/wine"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Selecciona una receta para consultar el detalle"
        android:textColor="@color/muted" android:layout_marginBottom="10dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecipes"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>