<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginBottom="9dp" android:background="@drawable/bg_card" android:padding="10dp">
    <TextView android:layout_width="48dp" android:layout_height="48dp"
        android:gravity="center" android:text="🍲" android:textSize="25sp"
        android:background="@drawable/bg_recipe_image"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/txtRecipeName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp"
            android:textColor="@color/ink"/>
        <TextView android:id="@+id/txtRecipeTime" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="28sp" android:textColor="@color/wine"/>
</LinearLayout>